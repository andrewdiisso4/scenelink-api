{
  "name": "scenelink-backend",
  "version": "1.0.0",
  "description": "SceneLink Production API - Boston dining, nightlife & events",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "seed": "node src/seeds/seed.js",
    "health": "curl -s http://localhost:3001/api/health | node -e \"process.stdin.on('data',d=>console.log(JSON.parse(d)))\"",
    "check": "find src qa -type f \\( -name \"*.js\" -o -name \"*.cjs\" -o -name \"*.mjs\" \\) -print0 | xargs -0 -n1 node --check",
    "migrate": "node src/server.js",
    "test": "node --test qa/*.test.cjs qa/*.test.mjs",
    "test:embedded": "node qa/embedded-integration.mjs",
    "test:integration": "node qa/connected-launch-integration.cjs",
    "test:ingestion": "node --test qa/event-ingestion-integration.cjs"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "keywords": [
    "scenelink",
    "boston",
    "dining",
    "nightlife",
    "events"
  ],
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^7.119.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.5",
    "google-auth-library": "^11.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "morgan": "^1.10.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11"
  }
}
