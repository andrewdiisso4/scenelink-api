# Copy this file to .env for local development
# For Render, set these as environment variables in the dashboard

DATABASE_URL=
JWT_SECRET=replace_with_64_char_random_string
CORS_ORIGINS=https://scenelink.app,https://www.scenelink.app
NODE_ENV=production
PORT=3001

# Optional server-only Resend transport for signup welcome and newsletter confirmation.
# Omit to keep configured SMTP. Set all three together, only after isolated inbox QA.
# Set cutoff to actual activation in UTC to avoid sending older pending welcomes.
# SIGNUP_MAIL_TRANSPORT=resend
# RESEND_SIGNUP_API_KEY=
# RESEND_SIGNUP_WELCOME_NOT_BEFORE=YYYY-MM-DDTHH:MM:SSZ
