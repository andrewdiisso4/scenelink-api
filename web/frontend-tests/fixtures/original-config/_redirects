# Phase 5M: Apple Universal Links + Android App Links must be reachable at /.well-known/*
# Netlify ZIP deploys strip dot-directories, so we host the files at /well-known-public/* and rewrite.
# Use 200 (rewrite) so the URL bar / iOS / Android verifier sees the canonical path.
/.well-known/apple-app-site-association  /well-known-public/apple-app-site-association  200
/.well-known/assetlinks.json             /well-known-public/assetlinks.json             200

# Soft 404 for unknown routes: send to custom 404 page with 404 status
# (Real static files like /favicon.ico, /robots.txt, /sitemap.xml are served directly)
/*  /404.html  404
